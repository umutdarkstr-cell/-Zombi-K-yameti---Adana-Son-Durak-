async function savas(zombiTipi, adet=1){
  let zombiProto = ZOMBI_TURLERI[zombiTipi];
  let zombiler = [];
  for(let i=0;i<adet;i++) zombiler.push({ ...zombiProto, can: zombiProto.can + rand(-10,20), id: i+1 });

  console.log(c("bgRed", `\n!!! ${adet} adet ${zombiProto.ad} saldırıyor !!!`));
  console.log(c("gray", zombiProto.aciklama));

  while(zombiler.length>0 && oyuncu.can>0){
    console.log("\n" + c("red", `--- SAVAŞ ---`));
    zombiler.forEach(z=> console.log(` ${z.id}. ${z.ad} [${z.can} HP]`));
    console.log(c("white", "\n[E] Saldır  [K] Kaç  [Ç] Çantadan eşya kullan  [B] Bağır (moral)"));
    let sec = (await ask("> ")).toLowerCase();

    if(sec==="k"){
      if(rand(1,10) > zombiProto.hiz*2){
        console.log(c("green", "Kaçmayı başardın! Ama bir şeyler düşürdün..."));
        if(oyuncu.envanter.length>0) oyuncu.envanter.pop();
        oyuncu.saat+=1;
        return true;
      } else {
        console.log(c("red", "Kaçamadın!"));
      }
    } else if(sec==="ç"){
      await envanterKullan(true);
    } else if(sec==="b"){
      console.log(c("yellow", "AVAZIN ÇIKTIĞI KADAR BAĞIRDIN: 'ADANA ZİRVEEEEE!!'"));
      oyuncu.moral+=5;
      if(zombiTipi==="bagiran"){ console.log(c("red", "HATA! Bağıran daha çok bağırdı, 2 zombi daha geldi!")); zombiler.push({...zombiProto, can:zombiProto.can, id: zombiler.length+1}); zombiler.push({...zombiProto, can:zombiProto.can, id: zombiler.length+2}); }
    } else {
      // saldırı
      let silah = ESYALAR[oyuncu.silah] || { hasar: [5,8] };
      let hasar = rand(silah.hasar[0], silah.hasar[1]);
      if(oyuncu.silah==="neşter" && rand(1,4)===1){ hasar*=2; console.log(c("magenta", "KRİTİK! Neşter tam şah damarına!")); }
      let hedef = zombiler[0];
      hedef.can-=hasar;
      console.log(c("green", `${hedef.ad}'ye ${hasar} hasar verdin!`));
      if(hedef.can<=0){ console.log(c("cyan", `${hedef.ad} öldü!`)); zombiler.shift(); oyuncu.oldurme++; oyuncu.moral+=2; }
    }

    // zombiler saldırır
    for(let z of zombiler){
      if(oyuncu.can<=0) break;
      let dmg = rand(z.hasar[0], z.hasar[1]);
      oyuncu.can-=dmg;
      oyuncu.enfeksiyon+= (zombiTipi==="siskan" ? 8 : 2);
      console.log(c("red", `${z.ad} sana ${dmg} vurdu!`));
      if(zombiTipi==="siskan" && z.can<20 && rand(1,2)===1){
        console.log(c("bgRed", "ŞİŞKİN PATLADI! Asit her yere saçıldı!"));
        oyuncu.can-=15;
        z.can=0;
      }
    }
    if(zombiler.length>0 && zombiler[0].can<=0) zombiler.shift();
  }

  if(oyuncu.can<=0){
    await olumEkrani();
    return false;
  } else {
    console.log(c("green", "\nBölge temizlendi. Nefes al..."));
    lootYap(oyuncu.konum);
    return true;
  }
}

async function envanterKullan(savastaMi=false){
  if(oyuncu.envanter.length===0){ console.log("Çanta boş."); return; }
  console.log("\nÇanta:");
  oyuncu.envanter.forEach((id,i)=> console.log(` ${i+1}. ${ESYALAR[id]?.ad || id} - ${ESYALAR[id]?.aciklama || ""}`));
  let sec = await ask("Kullanmak için numara (iptal: 0): ");
  let idx = parseInt(sec)-1;
  if(isNaN(idx) || idx<0 || idx>=oyuncu.envanter.length) return;
  let itemId = oyuncu.envanter[idx];
  let item = ESYALAR[itemId];
  if(!item){ oyuncu.envanter.splice(idx,1); return; }

  if(item.tur==="tuketim"){
    if(itemId==="su") oyuncu.susuzluk = Math.min(100, oyuncu.susuzluk+item.deger);
    else if(itemId==="konserve" || itemId==="ekmek") oyuncu.aclik = Math.min(100, oyuncu.aclik+item.deger);
    else if(itemId==="sargi" || itemId==="ilac"){ oyuncu.can = Math.min(100, oyuncu.can+item.deger); oyuncu.enfeksiyon = Math.max(0, oyuncu.enfeksiyon-15); }
    console.log(c("green", `${item.ad} kullanıldı.`));
    oyuncu.envanter.splice(idx,1);
  } else if(item.tur==="silah"){
    oyuncu.silah = itemId;
    console.log(c("cyan", `${item.ad} kuşanıldı.`));
  } else {
    console.log(item.aciklama);
  }
}

