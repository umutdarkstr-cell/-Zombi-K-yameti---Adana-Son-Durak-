async function craftMenusu(){
  console.log("\n--- CRAFT / ÜRETİM ---");
  console.log("1. Molotof Kokteyli [benzin + ekmek bezi (sargi) + çakmak] = Zombilere alan hasarı");
  console.log("2. Güçlendirilmiş Levye [levye + bant yok ama olsun: benzin + levye] = Hasar +5");
  console.log("3. Şalgam Suyu [su + tuz + baharat] = Moral +20, Susuzluk +30");
  console.log("4. Tuzlu Ekmek [ekmek + tuz] = Açlık +40");
  let sec = await ask("Ne üretmek istersin? (iptal: 0): ");
  if(sec==="1"){
    if(oyuncu.envanter.includes("benzin") && oyuncu.envanter.includes("sargi") && oyuncu.envanter.includes("çakmak")){
      oyuncu.envanter = oyuncu.envanter.filter(i=>!["benzin","sargi"].includes(i));
      oyuncu.envanter.push("molotof");
      ESYALAR["molotof"]={ ad:"Molotof", tur:"silah", hasar:[40,70], dayaniklilik:1, aciklama:"Tek kullanımlık, herkesi yakar" };
      console.log(c("green","Molotof yapıldı!"));
    } else console.log(c("red","Malzemen eksik!"));
  } else if(sec==="3"){
    if(oyuncu.envanter.includes("su") && oyuncu.envanter.includes("tuz")){
      oyuncu.envanter.splice(oyuncu.envanter.indexOf("su"),1);
      oyuncu.susuzluk = Math.min(100, oyuncu.susuzluk+30);
      oyuncu.moral = Math.min(100, oyuncu.moral+20);
      console.log(c("green","Ohhh mis gibi şalgam! Adanalı gibi hissettin."));
    } else console.log(c("red","Su ve tuz lazım."));
  } else if(sec==="4"){
    if(oyuncu.envanter.includes("ekmek") && oyuncu.envanter.includes("tuz")){
      oyuncu.envanter.splice(oyuncu.envanter.indexOf("ekmek"),1);
      oyuncu.aclik = Math.min(100, oyuncu.aclik+40);
      console.log(c("green","Tuzlu ekmek candır."));
    } else console.log(c("red","Ekmek ve tuz lazım."));
  }
}

